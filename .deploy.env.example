# Copy to .deploy.env. Do not commit .deploy.env.

REMOTE_SSH=root@1.117.63.81
REMOTE_APP_DIR=/root/code/personal-agent-ws/personal-agent
GIT_REMOTE=origin
GIT_BRANCH=master
PUBLIC_HOST=1.117.63.81
APP_BUSINESS_TIMEZONE=Asia/Shanghai

# Local gate before commit/push/deploy.
CHECK_CMD='make release-check'

# Set to 1 only for disposable/initial server DB state.
REMOTE_RESET_DB=0

# Required. Keep only in .deploy.env.
DB_PASSWORD=replace-with-server-db-password

# Recommended stable secret for signed entitlement tokens.
APP_ENTITLEMENT_SECRET=replace-with-hex-secret

# Optional real LLM observation layer. Rotate exposed keys before enabling.
APP_LLM_ENABLED=0
APP_LLM_PROVIDER=volcengine_ark_coding_plan
APP_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
APP_LLM_API_KEY=
APP_LLM_MODEL=doubao-seed-2.0-code
APP_LLM_PROMPT_VERSION=pr-ci-gate.v1
APP_LLM_INPUT_COST_PER_MILLION_USD=0
APP_LLM_OUTPUT_COST_PER_MILLION_USD=0

# Required when evaluation writes are exposed in production. Sent as X-Evaluation-Access.
APP_EVALUATION_WRITE_SECRET=replace-with-random-secret
