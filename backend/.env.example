APP_NAME=Personal Agent Assistant API
ENVIRONMENT=local
DEBUG=false
API_PREFIX=/api

# Default local (SQLite)
DATABASE_URL=sqlite:///./personal_agent.db

# PostgreSQL scaffolding example
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/personal_agent

# Optional real LLM observation layer. Keep disabled until a rotated key and model are configured.
# Use the Coding Plan OpenAI-compatible endpoint for subscription-backed evaluation.
APP_LLM_ENABLED=false
APP_LLM_PROVIDER=volcengine_ark_coding_plan
APP_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/coding/v3
APP_LLM_API_KEY=
APP_LLM_MODEL=doubao-seed-2.0-code
APP_LLM_PROMPT_VERSION=pr-ci-gate.v1
APP_LLM_TIMEOUT_SECONDS=30
APP_LLM_INPUT_COST_PER_MILLION_USD=0
APP_LLM_OUTPUT_COST_PER_MILLION_USD=0
APP_EVALUATION_WRITE_SECRET=
